{
  "name": "clickbank-ai-publishing-system",
  "version": "2.0.0",
  "private": true,
  "description": "Next.js affiliate AI publishing system for five niche websites.",
  "type": "module",
  "scripts": {
    "dev:legacy": "cross-env PORT=3001 node server.js",
    "dev:admin": "cross-env APP_MODE=admin PORT=3010 next start -p 3010",
    "dev:neuro": "cross-env APP_MODE=site SITE_SLUG=neuro-sleep PORT=3011 next start -p 3011",
    "dev:manifest": "cross-env APP_MODE=site SITE_SLUG=manifest-signal PORT=3012 next start -p 3012",
    "dev:ai": "cross-env APP_MODE=site SITE_SLUG=ai-hustle PORT=3013 next start -p 3013",
    "dev:metabolic": "cross-env APP_MODE=site SITE_SLUG=metabolic-reset PORT=3014 next start -p 3014",
    "dev:love": "cross-env APP_MODE=site SITE_SLUG=love-psychology PORT=3015 next start -p 3015",
    "dev": "concurrently -n LEGACY,ADMIN,NEURO,MANIFEST,AI,METABOLIC,LOVE -c white,yellow,blue,magenta,green,cyan,red \"npm:dev:legacy\" \"npm:dev:admin\" \"npm:dev:neuro\" \"npm:dev:manifest\" \"npm:dev:ai\" \"npm:dev:metabolic\" \"npm:dev:love\"",
    "build": "next build",
    "start": "next start -p ${PORT:-3010}",
    "lint": "next lint",
    "test": "npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.0",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.18",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "next": "^15.5.18",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "zod": "^4.2.1"
  }
